<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cadastrar Novo Usuário</title>
    <style>
        * {
            margin: 2px;
        }
    </style>
</head>
<body>
    <h1>Novo Usuário</h1>
    <form action="/usuarios/" method="post">
        Nome: <input type="text" id="nome" name="nome" required>
        <br>
        E-mail: <input type="email" id="email" name="email" required>
        <br>
        Login: <input type="text" id="login" name="login" required>
        <br>
        Senha: <input type="password" id="senha" name="senha" required>
        <br>
        <input type="submit" value="Cadastrar">
    </form>
</body>
</html>